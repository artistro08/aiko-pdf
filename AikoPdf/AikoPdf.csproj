<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AikoPdf</RootNamespace>
    <AssemblyName>AikoPdf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Aiko.ico</ApplicationIcon>
    <AssemblyTitle>Aiko</AssemblyTitle>
    <Product>Aiko</Product>
    <Company>Devin Green</Company>
    <Version>1.0.0.0</Version>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Unpackaged by default: runs from a plain folder with no runtime install. Passing
         -p:WindowsPackageType=MSIX instead builds the same app as a package, where the layout and the resource
         index are built against Package.appxmanifest, which is what lets XAML resolve under package identity. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(WindowsPackageType)' == 'MSIX'">true</EnableMsixTooling>
    <AppxPackageSigningEnabled Condition="'$(WindowsPackageType)' == 'MSIX'">false</AppxPackageSigningEnabled>
    <GenerateTestArtifacts Condition="'$(WindowsPackageType)' == 'MSIX'">false</GenerateTestArtifacts>
    <AppxBundle Condition="'$(WindowsPackageType)' == 'MSIX'">Never</AppxBundle>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Coding conventions: .editorconfig style rules and missing XML docs show up as build warnings -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shipped beside the app: the window and task bar load the icon at run time, and the MSIX manifest names
         the PNG logos, so both have to sit next to the executable -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <!-- Text geometry for selection. Windows.Data.Pdf renders pages but exposes no text, so this pure C# parser fills the gap. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <!-- Publish the compiled XAML with the app. dotnet publish leaves the app's own resources.pri and the .xbf
       files behind, which the framework ones do not replace: without them the published folder starts and dies
       with "Cannot locate resource from 'ms-appx:///MainWindow.xaml'". -->
  <Target Name="PublishCompiledXaml" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_AikoXamlResource Include="$(OutputPath)$(AssemblyName).pri" Condition="Exists('$(OutputPath)$(AssemblyName).pri')" />
      <_AikoXamlResource Include="$(OutputPath)resources.pri" Condition="Exists('$(OutputPath)resources.pri')" />
      <_AikoXamlResource Include="$(OutputPath)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_AikoXamlResource)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
