<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AikoPdf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Aiko">

    <!-- Root: accepts dropped files and the global open shortcut, hosts the title bar and the page frame -->
    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnPrintAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Title Bar Row: the WinUI TitleBar (drag region and pane toggle) takes the left, our own buttons sit
             beside it as ordinary content, and a spacer keeps them clear of the window's caption buttons. Keeping
             the buttons out of the TitleBar control means it can't fade them on its own delayed schedule. -->
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TitleBar
                x:Name="AppTitleBar"
                IsPaneToggleButtonVisible="False"
                PaneToggleRequested="OnPaneToggleRequested" />

            <!-- Title Buttons: open, then print and show in folder (document only), then open with -->
            <StackPanel
                x:Name="TitleButtons"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                PointerEntered="OnRightHeaderPointerEntered"
                PointerMoved="OnRightHeaderPointerEntered">
                <Button
                    x:Name="OpenButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnOpenClick"
                    ToolTipService.ToolTip="Open a PDF (Ctrl+O)">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <Button
                    x:Name="PrintButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnPrintClick"
                    ToolTipService.ToolTip="Print (Ctrl+P)">
                    <FontIcon Glyph="&#xE749;" FontSize="16" />
                </Button>
                <Button
                    x:Name="ShowInFolderButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnShowInFolderClick"
                    ToolTipService.ToolTip="Show in folder">
                    <FontIcon Glyph="&#xEC50;" FontSize="16" />
                </Button>
                <Button
                    x:Name="OpenWithButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnOpenWithClick"
                    ToolTipService.ToolTip="Open this PDF with another app">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
            </StackPanel>
            <!-- /Title Buttons -->

            <!-- Caption Spacer: sized in code to the window's minimize, maximize and close buttons -->
            <Border x:Name="CaptionSpacer" Grid.Column="2" Width="144" />

            <!-- Window Title: the document name, centered on the whole window. Dims with the buttons when the
                 window is inactive (see OnWindowMessage). -->
            <TextBlock
                x:Name="DocumentTitle"
                Grid.ColumnSpan="3"
                Style="{StaticResource CaptionTextBlockStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                TextTrimming="CharacterEllipsis" />
            <!-- /Window Title -->
        </Grid>
        <!-- /Title Bar Row -->

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
    <!-- /Root -->
</Window>
