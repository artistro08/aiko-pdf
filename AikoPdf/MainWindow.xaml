<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AikoPdf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Aiko">

    <!-- Root: accepts dropped files and the global open shortcut, hosts the title bar and the page frame -->
    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnPrintAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Title Bar Row: the WinUI TitleBar (drag region and pane toggle) takes the left, our own buttons sit
             beside it as ordinary content, and a spacer keeps them clear of the window's caption buttons. Keeping
             the buttons out of the TitleBar control means it can't fade them on its own delayed schedule. -->
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pane Toggle: a square button of our own, the full height of the bar less a small inset. The
                 TitleBar control's built-in toggle shrinks with its compact layout, which read as small and flat. -->
            <Button
                x:Name="PaneToggle"
                Visibility="Collapsed"
                Width="40"
                Height="40"
                Margin="4,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="OnPaneToggleClick"
                AutomationProperties.Name="Show or hide pages"
                ToolTipService.ToolTip="Show or hide pages">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </Button>

            <TitleBar
                x:Name="AppTitleBar"
                Grid.Column="1"
                IsPaneToggleButtonVisible="False" />

            <!-- Window Title: the document name, left-aligned next to the pane toggle and cut short with an ellipsis
                 when there is no room. Dims with the buttons when the window is inactive (see OnWindowMessage). -->
            <TextBlock
                x:Name="DocumentTitle"
                Grid.Column="1"
                Margin="12,0,12,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
            <!-- /Window Title -->

            <!-- Title Buttons: open, then print and show in folder (document only), then open with -->
            <StackPanel
                x:Name="TitleButtons"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                PointerEntered="OnRightHeaderPointerEntered"
                PointerMoved="OnRightHeaderPointerEntered">
                <Button
                    x:Name="OpenButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnOpenClick"
                    AutomationProperties.Name="Open a PDF"
                    ToolTipService.ToolTip="Open a PDF (Ctrl+O)">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <Button
                    x:Name="PrintButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnPrintClick"
                    AutomationProperties.Name="Print"
                    ToolTipService.ToolTip="Print (Ctrl+P)">
                    <FontIcon Glyph="&#xE749;" FontSize="16" />
                </Button>
                <Button
                    x:Name="ShowInFolderButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnShowInFolderClick"
                    AutomationProperties.Name="Show in folder"
                    ToolTipService.ToolTip="Show in folder">
                    <FontIcon Glyph="&#xEC50;" FontSize="16" />
                </Button>
                <Button
                    x:Name="OpenWithButton"
                    Visibility="Collapsed"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8,0"
                    Height="32"
                    Click="OnOpenWithClick"
                    AutomationProperties.Name="Open with another app"
                    ToolTipService.ToolTip="Open this PDF with another app">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
            </StackPanel>
            <!-- /Title Buttons -->

            <!-- Caption Spacer: sized in code to the window's minimize, maximize and close buttons -->
            <Border x:Name="CaptionSpacer" Grid.Column="3" Width="144" />
        </Grid>
        <!-- /Title Bar Row -->

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
    <!-- /Root -->
</Window>
