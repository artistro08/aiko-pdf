<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AikoPdf.Pages.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AikoPdf.Controls"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <!-- Island Fill: a touch darker than the window in either theme -->
        <SolidColorBrush x:Key="IslandFillBrush" Color="#000000" Opacity="0.18" />
        <!-- Tool Button: compact, same height as the zoom dropdown so the status bar reads as one row -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
        </Style>
        <!-- Tool Icon: the glyph size inside status bar buttons -->
        <x:Double x:Key="ToolIconSize">13</x:Double>
        <!-- Zoom Tooltip: the slider thumb reads as a percentage while dragging -->
        <controls:ZoomPercentConverter x:Key="ZoomPercentConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Document: thumbnail sidebar and the scrolling page stack -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: the host width is animated when the sidebar opens or closes, so the document re-centers
                 smoothly frame by frame instead of jumping the way a SplitView pane made it. -->
            <Grid x:Name="SidebarHost" Width="220" HorizontalAlignment="Left">
            <!-- Sidebar Island: rounded, set in from the sides, as tall as the document viewport -->
            <Border
                x:Name="SidebarIsland"
                Width="196"
                HorizontalAlignment="Left"
                Margin="12,0,12,8"
                RenderTransform="{x:Bind SidebarSlide}"
                CornerRadius="6"
                Background="{StaticResource IslandFillBrush}">
                <ListView
                    x:Name="ThumbnailList"
                    Width="196"
                    HorizontalAlignment="Left"
                    Padding="8"
                    SelectionMode="Single"
                    SelectionChanged="OnThumbnailSelected"
                    PointerEntered="OnThumbnailListPointerEntered"
                    PointerExited="OnThumbnailListPointerExited">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="8,12,8,8" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controls:ThumbnailItem">
                            <StackPanel Spacing="4" HorizontalAlignment="Center" Width="{x:Bind Width}">
                                <Border
                                    Width="{x:Bind Width}"
                                    Height="{x:Bind Height}"
                                    Background="White"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Fill" />
                                </Border>
                                <TextBlock
                                    Text="{x:Bind Label}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    HorizontalAlignment="Left"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <!-- /Sidebar Island -->
            </Grid>
            <!-- /Sidebar -->

            <ScrollViewer
                x:Name="Scroller"
                Grid.Column="1"
                VerticalAnchorRatio="0.33"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                ZoomMode="Disabled"
                IsTabStop="True"
                ViewChanged="OnViewChanged"
                SizeChanged="OnScrollerSizeChanged">
                <StackPanel
                    x:Name="PageStack"
                    Spacing="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    PointerWheelChanged="OnPageStackWheel"
                    PointerPressed="OnPageStackPressed" />
            </ScrollViewer>
        </Grid>
        <!-- /Document -->

        <!-- Status Bar: pages on the left, zoom on the right; a shade lighter than the window -->
        <Grid
            Grid.Row="1"
            Padding="8,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pages: go-to button that opens a page picker, then "3 of 12", previous, next -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    Style="{StaticResource ToolButtonStyle}"
                    ToolTipService.ToolTip="Go to page">
                    <!-- Nudged up: the page glyph sits visually low at this size -->
                    <FontIcon Glyph="&#xE7C3;" FontSize="{StaticResource ToolIconSize}" Margin="0,0,0,1" />
                    <Button.Flyout>
                        <Flyout x:Name="GoToFlyout" Placement="Top" Opened="OnGoToFlyoutOpened">
                            <ComboBox
                                x:Name="GoToBox"
                                IsEditable="True"
                                MinWidth="140"
                                PlaceholderText="Page number"
                                TextSubmitted="OnGoToSubmitted"
                                SelectionChanged="OnGoToSelected" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock
                    x:Name="PageText"
                    FontSize="12"
                    Margin="6,0,4,0"
                    VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button
                        Style="{StaticResource ToolButtonStyle}"
                        Click="OnPreviousClick"
                        ToolTipService.ToolTip="Previous page">
                        <FontIcon Glyph="&#xE76B;" FontSize="{StaticResource ToolIconSize}" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolButtonStyle}"
                        Click="OnNextClick"
                        ToolTipService.ToolTip="Next page">
                        <FontIcon Glyph="&#xE76C;" FontSize="{StaticResource ToolIconSize}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <!-- /Pages -->

            <!-- Zoom: dropdown, then out, slider, in -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <ComboBox
                    x:Name="ZoomCombo"
                    MinWidth="110"
                    MinHeight="26"
                    Height="26"
                    Padding="10,0,0,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="12"
                    SelectionChanged="OnZoomComboChanged"
                    ToolTipService.ToolTip="Zoom" />
                <Button
                    Style="{StaticResource ToolButtonStyle}"
                    Click="OnZoomOutClick"
                    ToolTipService.ToolTip="Zoom out (Ctrl+Minus)">
                    <FontIcon Glyph="&#xE71F;" FontSize="{StaticResource ToolIconSize}" />
                </Button>
                <Slider
                    x:Name="ZoomSlider"
                    Width="140"
                    MinHeight="0"
                    Margin="0"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="1"
                    IsThumbToolTipEnabled="True"
                    ThumbToolTipValueConverter="{StaticResource ZoomPercentConverter}"
                    VerticalAlignment="Center"
                    ValueChanged="OnZoomSliderChanged"
                    ToolTipService.ToolTip="Zoom" />
                <Button
                    Style="{StaticResource ToolButtonStyle}"
                    Click="OnZoomInClick"
                    ToolTipService.ToolTip="Zoom in (Ctrl+Plus)">
                    <FontIcon Glyph="&#xE8A3;" FontSize="{StaticResource ToolIconSize}" />
                </Button>
                <Rectangle
                    Width="1"
                    Height="16"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Button
                    Style="{StaticResource ToolButtonStyle}"
                    Click="OnHomeClick"
                    ToolTipService.ToolTip="Home">
                    <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource ToolIconSize}" />
                </Button>
                <Button
                    Style="{StaticResource ToolButtonStyle}"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="{StaticResource ToolIconSize}" />
                </Button>
            </StackPanel>
            <!-- /Zoom -->
        </Grid>
        <!-- /Status Bar -->
    </Grid>
</Page>
