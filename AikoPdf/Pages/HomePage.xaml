<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AikoPdf.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AikoPdf.Pages"
    xmlns:services="using:AikoPdf.Services">

    <Page.Resources>
        <!-- Same fill as the viewer's thumbnail island, so the two panels read as one family -->
        <SolidColorBrush x:Key="IslandFillBrush" Color="#000000" Opacity="0.18" />
    </Page.Resources>

    <Grid SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="WelcomeRow" Height="Auto" />
            <RowDefinition x:Name="RecentRow" Height="*" />
        </Grid.RowDefinitions>

        <!-- Welcome: icon, name and buttons centered in the top half, or the whole window when there are no recents.
             The scroller keeps the icon reachable instead of clipped when the window gets short. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="WelcomePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="32,24"
            Spacing="8">
            <Image
                Source="ms-appx:///Assets/Aiko.ico"
                Width="64"
                Height="64"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="Aiko"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleLargeTextBlockStyle}" />

            <TextBlock
                Text="Open a PDF to start reading. You can also drop a file anywhere in this window."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="WelcomeButtons"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,12,0,0"
                HorizontalAlignment="Center">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnOpenClick"
                    ToolTipService.ToolTip="Open a PDF (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="16" />
                        <TextBlock Text="Open a PDF" />
                    </StackPanel>
                </Button>
                <Button
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <!-- /Welcome -->

        <!-- Recent: small cards on their own panel, centered in the bottom half. The panel is sized in code to hold
             exactly four cards a row, or three in a narrow window, so it never runs to the window's edges. -->
        <Border
            x:Name="RecentIsland"
            Grid.Row="1"
            Margin="12,0,12,12"
            HorizontalAlignment="Center"
            CornerRadius="6"
            Background="{StaticResource IslandFillBrush}">
        <Grid>
            <!-- The list fills the whole panel and starts below the heading, so cards scroll up behind it and
                 fade out at the panel's own edge rather than stopping at a line under the heading. -->
            <ScrollViewer x:Name="RecentSection">
            <StackPanel
                Margin="24,60,24,16"
                HorizontalAlignment="Stretch"
                Spacing="8">
                <InfoBar
                    x:Name="Notice"
                    Severity="Warning"
                    IsOpen="False" />

                <!-- Cards: each one is a Button, which brings a rounded hover and press look for free. Centered in
                     the panel; the column count is set in code. -->
                <ItemsRepeater x:Name="RecentGrid" HorizontalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            x:Name="RecentLayout"
                            MinItemWidth="136"
                            MinRowSpacing="8"
                            MinColumnSpacing="16"
                            MaximumRowsOrColumns="4"
                            ItemsJustification="Center"
                            ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="services:RecentFile">
                            <!-- Card: first-page preview over the file name, folder and last-opened time -->
                            <Button
                                Padding="8"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="6"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                Tag="{x:Bind}"
                                Click="OnRecentClick"
                                RightTapped="OnRecentRightTapped">
                                <StackPanel Width="120" Spacing="6">
                                    <Border
                                        Height="156"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid>
                                            <FontIcon
                                                Glyph="&#xE8A5;"
                                                FontSize="32"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image
                                                Source="{x:Bind local:HomePage.Thumbnail(Path)}"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            FontSize="12"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock
                                            Text="{x:Bind Folder}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock
                                            Text="{x:Bind local:HomePage.FormatDate(LastOpened)}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <!-- /Card -->
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
            </ScrollViewer>

            <!-- Holds the faded copy of the list that the reader actually sees -->
            <Border x:Name="RecentFade" IsHitTestVisible="False" />

            <!-- Heading: its own small island of Mica, the window's material, rounded like the panel, staying put over
                 the list as it scrolls away beneath -->
            <Grid
                x:Name="RecentHeader"
                Margin="12,12,12,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <SystemBackdropElement CornerRadius="6">
                    <SystemBackdropElement.SystemBackdrop>
                        <MicaBackdrop />
                    </SystemBackdropElement.SystemBackdrop>
                </SystemBackdropElement>
                <TextBlock
                    Text="Recent"
                    Margin="12,4,12,6"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
            </Grid>
            <!-- /Heading -->
        </Grid>
        </Border>
        <!-- /Recent -->
    </Grid>
</Page>
