<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AikoPdf.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AikoPdf.Pages"
    xmlns:services="using:AikoPdf.Services">

    <Grid SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="WelcomeRow" Height="Auto" />
            <RowDefinition x:Name="RecentRow" Height="*" />
        </Grid.RowDefinitions>

        <!-- Welcome: icon, name and buttons centered in the top half, or the whole window when there are no recents.
             The scroller keeps the icon reachable instead of clipped when the window gets short. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="WelcomePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="32,24"
            Spacing="8">
            <Image
                Source="ms-appx:///Assets/Aiko.ico"
                Width="64"
                Height="64"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="Aiko"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleLargeTextBlockStyle}" />

            <TextBlock
                Text="Open a PDF to start reading. You can also drop a file anywhere in this window."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="WelcomeButtons"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,12,0,0"
                HorizontalAlignment="Center">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnOpenClick"
                    ToolTipService.ToolTip="Open a PDF (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="16" />
                        <TextBlock Text="Open a PDF" />
                    </StackPanel>
                </Button>
                <Button
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <!-- /Welcome -->

        <!-- Recent: small cards, left-aligned in the bottom half -->
        <ScrollViewer x:Name="RecentSection" Grid.Row="1">
            <StackPanel
                MaxWidth="1040"
                Margin="32,8,32,24"
                HorizontalAlignment="Stretch"
                Spacing="8">
                <TextBlock
                    x:Name="RecentHeader"
                    Text="Recent"
                    Margin="0,0,0,4"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <InfoBar
                    x:Name="Notice"
                    Severity="Warning"
                    IsOpen="False" />

                <!-- Cards: each one is a Button, which brings a rounded hover and press look for free. Pulled left
                     by the button padding and border so the previews line up with the "Recent" heading. -->
                <ItemsRepeater x:Name="RecentGrid" Margin="-9,0,0,0">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="136"
                            MinRowSpacing="4"
                            MinColumnSpacing="4"
                            ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="services:RecentFile">
                            <!-- Card: first-page preview over the file name, folder and last-opened time -->
                            <Button
                                Padding="8"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="6"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                Tag="{x:Bind}"
                                Click="OnRecentClick"
                                RightTapped="OnRecentRightTapped">
                                <StackPanel Width="120" Spacing="6">
                                    <Border
                                        Height="156"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid>
                                            <FontIcon
                                                Glyph="&#xE8A5;"
                                                FontSize="32"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image
                                                Source="{x:Bind local:HomePage.Thumbnail(Path)}"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            FontSize="12"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock
                                            Text="{x:Bind Folder}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock
                                            Text="{x:Bind local:HomePage.FormatDate(LastOpened)}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <!-- /Card -->
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
        <!-- /Recent -->
    </Grid>
</Page>
